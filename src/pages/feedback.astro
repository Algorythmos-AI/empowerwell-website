---
import { PAGES } from "../content/pages";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import Card from "../components/ui/Card.astro";
import Badge from "../components/ui/Badge.astro";
import Button from "../components/ui/Button.astro";
import HelpContacts from "../components/ui/HelpContacts.astro";
import { SITE } from "../content/site";

const linkClass =
  "inline-flex items-center min-h-[44px] font-bold text-purple-700 underline underline-offset-4 rounded-sm focus-visible:outline-3 focus-visible:outline-purple-700 focus-visible:outline-offset-2";

const steps = [
  {
    title: "Talk to us",
    body: "If you feel comfortable, tell your support worker. Many everyday problems can be fixed quickly.",
  },
  {
    title: "Make a complaint to us",
    body: `Call or email our directors, ${SITE.directors.join(" or ")}. We will listen, look into it, and tell you what we will do. You will not be treated badly for complaining.`,
  },
  {
    title: "Go to the NDIS Commission",
    body: "You can complain to the NDIS Quality and Safeguards Commission at any time. You do not have to complain to us first, and you can stay anonymous.",
  },
];
---

<BaseLayout meta={PAGES.feedback}>
  <Section variant="surface" class="pt-8 sm:pt-12 pb-16">
    <Container>
      <div class="max-w-4xl mx-auto space-y-10">
        <div>
          <Badge variant="tint" class="mb-4">Your right to speak up</Badge>
          <h1 class="text-4xl sm:text-5xl font-extrabold text-green-900 mb-4 leading-tight">Feedback & Complaints</h1>
          <p class="text-xl text-ink leading-relaxed">
            You always have the right to speak up. Compliments, ideas and complaints all help us give safer, better supports.
            You can have a family member, friend or advocate help you at any time.
          </p>
        </div>

        <section aria-labelledby="ways-heading" class="space-y-5">
          <h2 id="ways-heading" class="text-2xl font-bold text-green-900">Three ways to raise a concern</h2>
          <ol class="grid grid-cols-1 md:grid-cols-3 gap-6" role="list">
            {
              steps.map((step, i) => (
                <li>
                  <Card variant="white" padding="md" class="border border-green-100 h-full">
                    <span
                      class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-green-100 text-green-900 font-bold"
                      aria-hidden="true"
                    >
                      {i + 1}
                    </span>
                    <h3 class="text-xl font-bold text-green-900 mt-3 mb-2">{step.title}</h3>
                    <p class="text-base text-ink leading-relaxed">{step.body}</p>
                  </Card>
                </li>
              ))
            }
          </ol>
          <div class="flex flex-wrap gap-3">
            <Button href="/contact?service=feedback#enquiry-form" variant="primary" size="md">Send us feedback</Button>
            <Button href={SITE.phoneHref} variant="outline" size="md">Call {SITE.phone}</Button>
          </div>
        </section>

        <section aria-labelledby="commission-heading" class="p-6 sm:p-8 rounded-[12px] bg-surface-tint border-2 border-green-300 space-y-4">
          <Badge variant="green">Independent of us</Badge>
          <h2 id="commission-heading" class="text-2xl font-bold text-green-900">NDIS Quality and Safeguards Commission</h2>
          <p class="text-base sm:text-lg text-ink leading-relaxed">
            The NDIS Commission is the national regulator of NDIS providers. It takes complaints about any NDIS provider.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <div class="p-4 rounded-[12px] bg-white border border-green-200">
              <p class="font-bold text-muted uppercase text-sm tracking-wide">Phone</p>
              <a href={SITE.ndisCommissionPhoneHref} class={`${linkClass} text-xl`}>{SITE.ndisCommissionPhone}</a>
            </div>
            <div class="p-4 rounded-[12px] bg-white border border-green-200">
              <p class="font-bold text-muted uppercase text-sm tracking-wide">Online</p>
              <a href={SITE.ndisCommissionComplaintsUrl} class={linkClass} rel="noopener">Make a complaint on the Commission website</a>
            </div>
          </div>
          <p class="text-base text-ink">
            You can check that we are a registered NDIS provider (registration {SITE.ndisRegistration}) on the
            <a href={SITE.ndisProviderRegisterUrl} class={linkClass} rel="noopener">NDIS Provider Register</a>.
          </p>
        </section>

        <section aria-labelledby="advocate-heading" class="space-y-3">
          <h2 id="advocate-heading" class="text-2xl font-bold text-green-900">Getting help from an advocate</h2>
          <p class="text-base sm:text-lg text-ink leading-relaxed">
            An advocate is someone independent who can help you speak up. Advocacy services are free.
          </p>
          <a href={SITE.advocacyUrl} class={linkClass} rel="noopener">Find a disability advocate (Disability Gateway)</a>
        </section>

        <HelpContacts />
      </div>
    </Container>
  </Section>
</BaseLayout>
