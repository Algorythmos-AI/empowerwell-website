---
import { PAGES } from "../content/pages";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import Card from "../components/ui/Card.astro";
import Badge from "../components/ui/Badge.astro";
import Button from "../components/ui/Button.astro";
import { SITE } from "../content/site";
import { SERVICES } from "../content/services";
---

<BaseLayout meta={PAGES.services}>
  <Section variant="surface" class="pt-8 sm:pt-12 pb-12">
    <Container>
      <div class="max-w-3xl">
        <Badge variant="tint" class="mb-4">{SERVICES.length} registered NDIS supports</Badge>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-green-900 mb-6 leading-tight">Our NDIS Services</h1>
        <p class="text-xl text-ink leading-relaxed">
          We are registered with the NDIS Quality and Safeguards Commission to provide these {SERVICES.length} supports. Each one is
          planned around your routine, your goals and your culture.
        </p>
      </div>

      <nav aria-labelledby="service-index-heading" class="mt-8 max-w-4xl">
        <h2 id="service-index-heading" class="text-lg font-bold text-green-900 mb-3">Jump to a service</h2>
        <ul class="flex flex-wrap gap-2" role="list">
          {
            SERVICES.map((service) => (
              <li>
                <a
                  href={`#${service.slug}`}
                  class="inline-flex items-center min-h-[44px] px-4 rounded-full bg-white border border-green-200 text-base font-bold text-ink hover:border-purple-700 hover:text-purple-700 transition-colors focus-visible:outline-3 focus-visible:outline-purple-700 focus-visible:outline-offset-2"
                >
                  {service.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </Container>
  </Section>

  <Section variant="tint">
    <Container>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-8" role="list">
        {
          SERVICES.map((service) => (
            <li id={service.slug}>
              <Card variant="white" padding="lg" class="h-full flex flex-col justify-between border border-green-100">
                <div class="space-y-4">
                  <h2 class="text-2xl font-bold text-ink">{service.title}</h2>
                  <p class="text-lg text-ink leading-relaxed">{service.shortDescription}</p>
                  <p class="text-base text-ink leading-relaxed">{service.fullDescription}</p>
                  {service.image && (
                    <figure class="rounded-[12px] overflow-hidden border border-green-100 bg-surface-tint">
                      <img src={service.image.src} alt={service.image.alt} width="800" height="500" loading="lazy" class="w-full h-auto" />
                      <figcaption class="px-4 py-3 text-base font-bold text-green-900 bg-white border-t border-green-100">{service.image.caption}</figcaption>
                    </figure>
                  )}
                  <div class="pt-1">
                    <h3 class="text-base font-bold text-green-900 mb-2">This can include:</h3>
                    <ul class="space-y-2 text-base text-ink" role="list">
                      {service.features.map((feat) => (
                        <li class="flex items-start gap-2">
                          <svg class="w-5 h-5 mt-0.5 shrink-0 text-green-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M20 6 9 17l-5-5"></path>
                          </svg>
                          <span>{feat}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                  <p class="text-sm text-muted">NDIS registration group: {service.ndisGroup}</p>
                </div>

                <div class="pt-6 mt-6 border-t border-green-100">
                  <Button
                    href={`/contact?service=${encodeURIComponent(service.slug)}#enquiry-form`}
                    variant="outline"
                    size="md"
                    class="w-full"
                  >
                    Ask about this service<span class="sr-only">: {service.title}</span>
                  </Button>
                </div>
              </Card>
            </li>
          ))
        }
      </ul>
    </Container>
  </Section>

  <Section variant="surface">
    <Container>
      <div class="p-8 sm:p-12 rounded-[12px] bg-surface-tint border border-green-200 max-w-4xl mx-auto space-y-6 text-center">
        <Badge variant="green">Where we work</Badge>
        <h2 class="text-3xl font-extrabold text-green-900">Supporting people across {SITE.serviceAreas}</h2>
        <p class="text-lg text-ink leading-relaxed max-w-2xl mx-auto">
          We are based in {SITE.suburb}. {SITE.supportHours}. Call us to check if we can support you where you live.
        </p>
        <div class="pt-2 flex flex-wrap justify-center gap-4">
          <Button href={SITE.phoneHref} variant="primary" size="md">Call {SITE.phone}</Button>
          <Button href={SITE.phone2Href} variant="primary" size="md">Call {SITE.phone2}</Button>
          <Button href="/contact#enquiry-form" variant="outline" size="md">Send us a question</Button>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
