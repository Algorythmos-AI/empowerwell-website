---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import Card from "../components/ui/Card.astro";
import Badge from "../components/ui/Badge.astro";
import Button from "../components/ui/Button.astro";
import { SITE } from "../content/site";
import { SERVICES } from "../content/services";
---

<BaseLayout
  title={`NDIS Services · ${SITE.brandName} · Western Sydney & Regional NSW`}
  description="Explore our 11 NDIS registered services, including Supported Independent Living (SIL), Personal Care, Community Participation, and Life Skills development."
>
  {/* Services Hero */}
  <Section variant="surface" class="pt-8 sm:pt-12 pb-12">
    <Container>
      <div class="max-w-3xl">
        <Badge variant="tint" class="mb-4">11 Core NDIS Supports</Badge>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-green-900 mb-6 leading-tight">
          Comprehensive, Tailored Supports for Your Independence
        </h1>
        <p class="text-xl text-ink leading-relaxed">
          Every support service at Empowerwell is customized around your routine, goals, and cultural preferences. We operate 24 hours a day, 7 days a week across Greater Sydney and regional NSW.
        </p>
      </div>
    </Container>
  </Section>

  {/* Services Grid */}
  <Section variant="tint">
    <Container>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          SERVICES.map((service, index) => (
            <Card
              variant="white"
              padding="lg"
              class="flex flex-col justify-between hover:shadow-soft-lg transition-all border border-green-100"
            >
              <div class="space-y-4">
                <div class="flex items-center justify-between">
                  <div class="w-12 h-12 rounded-full bg-surface-tint border border-green-200 flex items-center justify-center text-green-900 font-bold">
                    <span class="text-base font-heading font-extrabold text-green-900">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                  </div>
                  {service.isHighlight && (
                    <Badge variant="lime" class="text-xs">
                      Popular Support
                    </Badge>
                  )}
                </div>

                <h2 class="text-2xl font-bold text-ink">
                  {service.title}
                </h2>

                <p class="text-base text-muted leading-relaxed">
                  {service.shortDescription}
                </p>

                <p class="text-sm text-ink leading-relaxed pt-2">
                  {service.fullDescription}
                </p>

                <div class="pt-2">
                  <p class="text-xs font-bold text-green-900 uppercase tracking-wider mb-2">
                    Key Inclusions:
                  </p>
                  <ul class="space-y-1.5 text-xs sm:text-sm text-ink">
                    {service.features.map((feat) => (
                      <li class="flex items-start gap-2">
                        <span class="text-green-600 font-bold shrink-0">✓</span>
                        <span>{feat}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <div class="pt-6 mt-6 border-t border-green-100">
                <Button
                  href={`/contact?service=${encodeURIComponent(service.slug)}`}
                  variant="outline"
                  size="sm"
                  class="w-full text-center"
                >
                  Enquire about {service.title}
                </Button>
              </div>
            </Card>
          ))
        }
      </div>
    </Container>
  </Section>

  {/* Service Area & Availability Note */}
  <Section variant="surface">
    <Container>
      <div class="p-8 sm:p-12 rounded-[16px] bg-surface-tint border border-green-200 max-w-4xl mx-auto space-y-6 text-center">
        <Badge variant="green">Service Coverage</Badge>
        <h2 class="text-3xl font-extrabold text-green-900">
          Servicing Western Sydney & Regional Communities
        </h2>
        <p class="text-lg text-ink leading-relaxed max-w-2xl mx-auto">
          We actively provide daily and 24/7 SIL supports in Blacktown, Penrith, Parramatta, Dharruk, Liverpool, Campbelltown, and throughout regional New South Wales.
        </p>
        <div class="pt-2 flex flex-wrap justify-center gap-4">
          <Button href="/contact" variant="primary" size="md">
            Check Service Availability in Your Suburb
          </Button>
          <Button href={SITE.phoneHref} variant="ghost" size="md">
            Call Our Intake Team ({SITE.phone})
          </Button>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
