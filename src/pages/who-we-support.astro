---
import { PAGES } from "../content/pages";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import Card from "../components/ui/Card.astro";
import Badge from "../components/ui/Badge.astro";
import Button from "../components/ui/Button.astro";
import { SITE } from "../content/site";

// Focus groups from the client's business plan: mainly intellectual disability and autism,
// with low to medium support needs. Don't add high-intensity supports (not a registration group).
const participantGroups = [
  {
    id: "autism",
    title: "Autistic people",
    description: "Support workers who understand routines, sensory needs and clear communication, at home and out in the community.",
    features: [
      "Building steady, predictable routines",
      "Support for outings and trying new hobbies",
      "Patient, calm support without judgement",
      "Learning to travel and manage money",
    ],
  },
  {
    id: "intellectual-disability",
    title: "People with intellectual disability",
    description: "Support to learn everyday skills, make friends and make your own decisions.",
    features: [
      "Clear, step-by-step help, with pictures if that helps you",
      "Help with personal care and cooking",
      "Joining community and group activities",
      "Setting goals and celebrating them with your family",
    ],
  },
  {
    id: "ageing",
    title: "NDIS participants who are getting older",
    description: "Support to stay comfortable, safe and independent at home as your needs change.",
    features: [
      "Help with personal care and moving around safely",
      "Reminders for medication and help getting to appointments",
      "Help with household jobs and meals",
      "Company and support to stay connected",
    ],
  },
];

const planTypes = [
  { name: "Self-managed", body: "You pay us and claim the money back. We give you clear invoices for your claims." },
  { name: "Plan-managed", body: "We send our invoices to your plan manager, who pays us from your NDIS plan." },
  { name: "Agency-managed (NDIA)", body: "We claim payment from the NDIA. Only registered providers like us can do this." },
];
---

<BaseLayout meta={PAGES.whoWeSupport}>
  <Section variant="surface" class="pt-8 sm:pt-12 pb-12">
    <Container>
      <div class="max-w-3xl">
        <Badge variant="tint" class="mb-4">Who we support</Badge>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-green-900 mb-6 leading-tight">Support That Starts With You</h1>
        <p class="text-xl text-ink leading-relaxed">
          We work with you, your family, your carers and your support coordinator to build support that fits who you are.
        </p>
      </div>
    </Container>
  </Section>

  <Section variant="tint">
    <Container>
      <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-green-900 mb-4">People We Support</h2>
        <p class="text-lg text-ink">
          We mainly support people with low to medium support needs. If you are not sure we are the right fit, call us and ask.
        </p>
      </div>

      <ul class="grid grid-cols-1 lg:grid-cols-3 gap-8" role="list">
        {
          participantGroups.map((group) => (
            <li>
              <Card variant="white" padding="lg" class="h-full border border-green-100 flex flex-col justify-between">
                <div class="space-y-4">
                  <h3 class="text-2xl font-bold text-purple-700">{group.title}</h3>
                  <p class="text-base text-ink leading-relaxed">{group.description}</p>
                  <div class="pt-1">
                    <h4 class="text-base font-bold text-green-900 mb-2">How we help:</h4>
                    <ul class="space-y-2 text-base text-ink" role="list">
                      {group.features.map((feat) => (
                        <li class="flex items-start gap-2">
                          <svg class="w-5 h-5 mt-0.5 shrink-0 text-green-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M20 6 9 17l-5-5"></path>
                          </svg>
                          <span>{feat}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
                <div class="pt-6 mt-6 border-t border-green-100">
                  <Button href="/contact#enquiry-form" variant="outline" size="md" class="w-full">
                    Talk to us<span class="sr-only"> about support for {group.title.toLowerCase()}</span>
                  </Button>
                </div>
              </Card>
            </li>
          ))
        }
      </ul>
    </Container>
  </Section>

  <Section variant="surface">
    <Container>
      <div class="max-w-4xl mx-auto space-y-8">
        <div class="text-center">
          <Badge variant="green" class="mb-3">All plan types welcome</Badge>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-green-900 mb-4">Self, Plan and Agency-Managed Plans</h2>
          <p class="text-lg text-ink">
            We are a registered NDIS provider ({SITE.ndisRegistration}), so we can support you however your plan is managed.
          </p>
        </div>

        <ul class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4" role="list">
          {
            planTypes.map((plan) => (
              <li>
                <Card variant="tint" padding="md" class="h-full text-center space-y-3">
                  <h3 class="text-xl font-bold text-green-900">{plan.name}</h3>
                  <p class="text-base text-ink leading-relaxed">{plan.body}</p>
                </Card>
              </li>
            ))
          }
        </ul>

        <div class="p-6 rounded-[12px] bg-purple-50 border border-purple-200 text-center space-y-3">
          <h2 class="text-xl font-bold text-purple-900">Are you a support coordinator or Local Area Coordinator (LAC)?</h2>
          <p class="text-base text-ink max-w-2xl mx-auto">
            Send us a referral and we will contact you to talk about the participant's needs and goals.
          </p>
          <div class="pt-2">
            <Button href="/contact#enquiry-form" variant="primary" size="md">Make a Referral</Button>
          </div>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
