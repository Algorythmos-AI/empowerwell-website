---
import { PAGES } from "../content/pages";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import Card from "../components/ui/Card.astro";
import Badge from "../components/ui/Badge.astro";
import EnquiryForm from "../components/islands/EnquiryForm";
import { SITE } from "../content/site";
import { SERVICES } from "../content/services";

const serviceOptions = SERVICES.map((s) => ({
  slug: s.slug,
  title: s.title,
}));
---

<BaseLayout meta={PAGES.contact}>
  {/* Hero Header */}
  <Section variant="surface" class="pt-8 sm:pt-12 pb-10">
    <Container>
      <div class="max-w-3xl">
        <Badge variant="tint" class="mb-4">Get in Touch</Badge>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-green-900 mb-6 leading-tight">
          Make a Referral or Start a Conversation
        </h1>
        <p class="text-xl text-ink leading-relaxed">
          We welcome self-referrals from participants, referrals from family and carers, and referrals from Support Coordinators and LACs across Greater Sydney.
        </p>
      </div>
    </Container>
  </Section>

  {/* Main Form & Contact Info Split */}
  <Section variant="tint">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        {/* Left Column: Interactive Form Island */}
        <div class="lg:col-span-8">
          <EnquiryForm
            client:load
            services={serviceOptions}
            recipient={SITE.email}
            endpoint={SITE.formEndpoint}
            phone={SITE.phone}
            phoneHref={SITE.phoneHref}
          />
          <noscript>
            <p class="mt-4 p-4 rounded-[12px] bg-surface-tint border border-green-200 text-sm text-ink">
              JavaScript is turned off, so this form will open your email app to send your enquiry. You can also call us on
              <a href={SITE.phoneHref} class="font-bold text-purple-700 underline">{SITE.phone}</a> or email
              <a href={SITE.emailHref} class="font-bold text-purple-700 underline">{SITE.email}</a>.
            </p>
          </noscript>
        </div>

        {/* Right Column: Direct Contact Info & Office Details */}
        <div class="lg:col-span-4 space-y-6">
          {/* Quick Call Card */}
          <Card variant="white" padding="md" class="border-t-4 border-purple-700">
            <h2 class="text-xl font-bold text-green-900 mb-2">
              Speak with Our Team
            </h2>
            <p class="text-sm text-ink mb-4 leading-relaxed">
              Prefer to talk on the phone? Give us a call during office hours, or leave a message for our 24/7 on-call coordinator.
            </p>
            <a
              href={SITE.phoneHref}
              class="w-full flex items-center justify-center gap-2.5 py-3.5 px-6 rounded-full bg-purple-700 text-white font-bold hover:bg-purple-800 transition-colors shadow-soft text-center min-h-[44px] focus-visible:outline-3 focus-visible:outline-green-900"
            >
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <span>{SITE.phone}</span>
            </a>
          </Card>

          {/* Email & Office Card */}
          <Card variant="white" padding="md" class="space-y-4">
            <div>
              <h3 class="text-sm font-bold text-muted uppercase tracking-wider">
                Email
              </h3>
              <a href={SITE.emailHref} class="text-base font-bold text-purple-700 hover:underline">
                {SITE.email}
              </a>
            </div>

            <div>
              <h3 class="text-sm font-bold text-muted uppercase tracking-wider">
                Head Office
              </h3>
              <p class="text-base text-ink font-medium">
                {SITE.suburb} {SITE.state} {SITE.postcode}, Australia
              </p>
              <p class="text-xs text-muted mt-0.5">
                Servicing Greater Sydney & Regional NSW
              </p>
            </div>

            <div>
              <h3 class="text-sm font-bold text-muted uppercase tracking-wider">
                Office Hours
              </h3>
              <p class="text-sm text-ink">
                {SITE.officeHours}
              </p>
              <p class="text-xs text-green-700 font-bold mt-1">
                Supports available 24 hours / 7 days
              </p>
            </div>

            <div class="pt-2 border-t border-green-100">
              <h3 class="text-sm font-bold text-muted uppercase tracking-wider">
                NDIS Registration
              </h3>
              <p class="text-sm font-bold text-green-900 mt-1">
                ID: {SITE.ndisRegistration}
              </p>
              <p class="text-xs text-muted">
                ABN: {SITE.abn}
              </p>
            </div>
          </Card>

          {/* Service Area Promise */}
          <Card variant="tint" padding="md" class="border border-green-200">
            <h3 class="text-base font-bold text-green-900 mb-2">
              Our Service Guarantee
            </h3>
            <ul class="space-y-1.5 text-xs text-ink leading-relaxed">
              <li class="flex items-start gap-1.5">
                <span class="text-green-700 font-bold">✓</span>
                <span>Response within 24 business hours</span>
              </li>
              <li class="flex items-start gap-1.5">
                <span class="text-green-700 font-bold">✓</span>
                <span>Free meet and greet with no obligation</span>
              </li>
              <li class="flex items-start gap-1.5">
                <span class="text-green-700 font-bold">✓</span>
                <span>Immediate capacity for SIL and daily supports</span>
              </li>
            </ul>
          </Card>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
