---
import { PAGES } from "../content/pages";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import Card from "../components/ui/Card.astro";
import Badge from "../components/ui/Badge.astro";
import HelpContacts from "../components/ui/HelpContacts.astro";
import EnquiryForm from "../components/islands/EnquiryForm";
import { SITE } from "../content/site";
import { SERVICES } from "../content/services";

const serviceOptions = SERVICES.map((s) => ({ slug: s.slug, title: s.title }));

const phoneIcon =
  "M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z";
const callButton =
  "w-full flex items-center justify-center gap-2.5 py-3.5 px-6 rounded-full bg-green-900 text-white font-bold hover:bg-green-800 transition-colors shadow-soft text-center min-h-[44px] focus-visible:outline-3 focus-visible:outline-purple-700 focus-visible:outline-offset-2";
const nextSteps = [
  "We call you to talk about your goals and your NDIS plan.",
  "We meet you for a free meet and greet. There is no obligation.",
  "We agree your supports, times and costs in a service agreement.",
];
---

<BaseLayout meta={PAGES.contact}>
  <Section variant="surface" class="pt-8 sm:pt-12 pb-10">
    <Container>
      <div class="max-w-3xl">
        <Badge variant="tint" class="mb-4">Get in touch</Badge>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-green-900 mb-6 leading-tight">
          Make a Referral or Ask a Question
        </h1>
        <p class="text-xl text-ink leading-relaxed">
          Participants, families, carers, support coordinators and Local Area Coordinators (LACs) are all welcome to contact
          us.
        </p>

        <!-- Phone first on small screens: calling is the quickest route for many visitors. -->
        <div class="mt-6 lg:hidden p-5 rounded-[12px] bg-surface-tint border border-green-200 space-y-3">
          <p class="text-lg font-bold text-green-900">Prefer to talk? Call us.</p>
          <a href={SITE.phoneHref} class={callButton}>
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={phoneIcon}></path></svg>
            <span>Call {SITE.phone}</span>
          </a>
          <a href={SITE.phone2Href} class={callButton}>
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={phoneIcon}></path></svg>
            <span>Call {SITE.phone2}</span>
          </a>
          <p class="text-base text-ink">Or fill in the form below and we will contact you.</p>
        </div>
      </div>
    </Container>
  </Section>

  <Section variant="tint">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-8">
          <section id="enquiry-form" aria-labelledby="enquiry-form-heading">
            <h2 id="enquiry-form-heading" class="text-2xl sm:text-3xl font-extrabold text-green-900 mb-5">Enquiry form</h2>
            <EnquiryForm
              client:load
              services={serviceOptions}
              recipient={SITE.email}
              endpoint={SITE.formEndpoint}
              phone={SITE.phone}
              phoneHref={SITE.phoneHref}
              phone2={SITE.phone2}
              phone2Href={SITE.phone2Href}
            />
            <noscript>
              <div class="p-5 rounded-[12px] bg-white border border-green-200 text-base text-ink space-y-2">
                <p class="font-bold text-green-900">This form needs JavaScript.</p>
                <p>
                  Please call us on <a href={SITE.phoneHref} class="font-bold text-purple-700 underline">{SITE.phone}</a> or
                  <a href={SITE.phone2Href} class="font-bold text-purple-700 underline">{SITE.phone2}</a>
                  or email <a href={SITE.emailHref} class="font-bold text-purple-700 underline">{SITE.email}</a>.
                </p>
              </div>
            </noscript>
          </section>
        </div>

        <aside class="lg:col-span-4 space-y-6" aria-label="Other ways to contact us">
          <Card variant="white" padding="md" class="hidden lg:block border-t-4 border-green-900">
            <h2 class="text-xl font-bold text-green-900 mb-2">Prefer to talk?</h2>
            <p class="text-base text-ink mb-4 leading-relaxed">Call us during office hours ({SITE.officeHours}).</p>
            <a href={SITE.phoneHref} class={callButton}>
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={phoneIcon}></path></svg>
              <span>{SITE.phone}</span>
            </a>
            <a href={SITE.phone2Href} class={callButton}>
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={phoneIcon}></path></svg>
              <span>{SITE.phone2}</span>
            </a>
          </Card>

          <Card variant="white" padding="md" class="space-y-4">
            <h2 class="text-xl font-bold text-green-900">Contact details</h2>
            <dl class="space-y-4">
              <div>
                <dt class="text-sm font-bold text-muted uppercase tracking-wider">Email</dt>
                <dd>
                  <a href={SITE.emailHref} class="inline-flex items-center min-h-[44px] text-base font-bold text-purple-700 underline underline-offset-4 break-all rounded-sm focus-visible:outline-3 focus-visible:outline-purple-700 focus-visible:outline-offset-2">{SITE.email}</a>
                </dd>
              </div>
              <div>
                <dt class="text-sm font-bold text-muted uppercase tracking-wider">Office</dt>
                <dd class="text-base text-ink">{SITE.streetAddress}, {SITE.suburb} {SITE.state} {SITE.postcode}</dd>
                <dd class="text-sm text-muted mt-0.5">Supporting participants across {SITE.serviceAreas}</dd>
              </div>
              <div>
                <dt class="text-sm font-bold text-muted uppercase tracking-wider">Office hours</dt>
                <dd class="text-base text-ink">{SITE.officeHours}</dd>
                <dd class="text-sm text-ink mt-1">{SITE.supportHours}.</dd>
              </div>
              <div class="pt-3 border-t border-green-100">
                <dt class="text-sm font-bold text-muted uppercase tracking-wider">NDIS registration</dt>
                <dd class="text-base font-bold text-green-900 mt-1">{SITE.ndisRegistration}</dd>
                <dd class="text-sm text-muted">ABN {SITE.abn}</dd>
              </div>
            </dl>
          </Card>

          <Card variant="tint" padding="md" class="border border-green-200">
            <h2 class="text-xl font-bold text-green-900 mb-3">What happens next</h2>
            <ol class="list-decimal pl-5 space-y-2 text-base text-ink leading-relaxed">
              {nextSteps.map((step) => <li>{step}</li>)}
            </ol>
          </Card>
        </aside>
      </div>

      <HelpContacts class="mt-12" />
    </Container>
  </Section>
</BaseLayout>
