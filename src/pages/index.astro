---
import { PAGES } from "../content/pages";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import Card from "../components/ui/Card.astro";
import Badge from "../components/ui/Badge.astro";
import Button from "../components/ui/Button.astro";
import { SITE } from "../content/site";
import { SERVICES } from "../content/services";
import { VALUES } from "../content/values";
import { Picture } from "astro:assets";
import { COMMUNITY_GALLERY, PHOTOS } from "../content/photos";

const featuredServices = SERVICES.filter((s) => s.featured).slice(0, 6);

// One simple line icon per featured service (24×24 stroke paths).
const ICONS: Record<string, string> = {
  "personal-care": "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z",
  sil: "M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6",
  "household-tasks": "M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z",
  "community-participation": "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z",
  transport: "M9 17a2 2 0 11-4 0 2 2 0 014 0zm10 0a2 2 0 11-4 0 2 2 0 014 0zM13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1",
  "life-skills": "M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253",
};
const DEFAULT_ICON = "M5 13l4 4L19 7";

const keyValues = VALUES.slice(0, 3);

const steps = [
  { title: "We talk", body: `Call us on ${SITE.phone} or send the enquiry form. We talk about your goals and your NDIS plan.` },
  { title: "We meet", body: "We meet you at home or somewhere in the community. It is free and there is no obligation." },
  { title: "Supports start", body: "We agree your supports, times and costs in a service agreement. Then your supports begin." },
];
---

<BaseLayout meta={PAGES.home}>
  <Section variant="surface" class="pt-8 sm:pt-12 md:pt-16 pb-16">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 space-y-6">
          <Badge variant="tint" class="text-sm">Registered NDIS Provider · {SITE.ndisRegistration}</Badge>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-green-900 leading-[1.15]">
            Empowering You to <span class="text-purple-700">Thrive</span> with Choice & Dignity
          </h1>

          <p class="text-lg sm:text-xl text-ink leading-relaxed max-w-2xl">
            We give friendly, respectful disability support that fits your life, including Supported Independent Living
            (SIL), personal care and help to get out into your community. We support people across {SITE.serviceAreas}.
          </p>

          <div class="pt-2 flex flex-wrap items-center gap-4">
            <Button href="/contact#enquiry-form" variant="primary" size="lg">Make a Referral</Button>
            <Button href={SITE.phoneHref} variant="outline" size="lg">
              <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
              <span>Call {SITE.phone}</span>
            </Button>
          </div>

          <ul class="pt-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-base text-ink" role="list">
            {
              ["Free meet and greet", "Agency, plan and self-managed plans", "Wheelchair-accessible van", "Supports 24/7 if you need them"].map((point) => (
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-green-700 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>{point}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="lg:col-span-5">
          <figure class="rounded-[12px] overflow-hidden border-2 border-green-100 shadow-soft-lg bg-surface-tint">
            <Picture
              src={PHOTOS.shoppingCentreOuting.src}
              alt={PHOTOS.shoppingCentreOuting.alt}
              formats={["avif", "webp"]}
              widths={[480, 800, 1200, 1600]}
              sizes="(min-width: 1024px) 40vw, 100vw"
              loading="eager"
              fetchpriority="high"
              class="w-full h-auto aspect-[4/3] object-cover"
            />
            <figcaption class="p-4 bg-white border-t border-green-100">
              <span class="block text-sm text-muted font-bold uppercase tracking-wider">Support in your community</span>
              <span class="block text-base font-bold text-green-900">One-on-one support that fits your life and your goals.</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </Container>
  </Section>

  <section class="bg-purple-700 text-white py-5" aria-label="About our registration">
    <Container>
      <ul class="flex flex-wrap items-center justify-center gap-x-10 gap-y-3 text-center text-base font-bold" role="list">
        <li class="flex items-center gap-2">
          <svg class="w-5 h-5 text-lime-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
          </svg>
          <span>Registered NDIS provider</span>
        </li>
        <li class="flex items-center gap-2">
          <svg class="w-5 h-5 text-lime-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span>Supports 24/7 if you need them</span>
        </li>
        <li class="flex items-center gap-2">
          <svg class="w-5 h-5 text-lime-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
          </svg>
          <span>{SITE.serviceAreas}</span>
        </li>
      </ul>
    </Container>
  </section>

  <Section variant="surface" id="services">
    <Container>
      <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
        <Badge variant="tint" class="mb-3">Our supports</Badge>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-green-900 mb-4">Support Built Around Your Goals</h2>
        <p class="text-lg text-ink">From help at home to getting out in the community, we plan every support with you.</p>
      </div>

      <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" role="list">
        {
          featuredServices.map((service) => (
            <li>
              <Card variant="white" padding="md" class="h-full flex flex-col justify-between">
                <div class="space-y-4">
                  <div class="w-12 h-12 rounded-full bg-surface-tint border border-green-200 flex items-center justify-center">
                    <svg class="w-6 h-6 text-green-800" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d={ICONS[service.slug] ?? DEFAULT_ICON}></path>
                    </svg>
                  </div>
                  <h3 class="text-xl font-bold text-ink">{service.title}</h3>
                  <p class="text-base text-ink leading-relaxed">{service.shortDescription}</p>
                </div>
                <div class="pt-4 mt-6 border-t border-green-100">
                  <a
                    href={`/services#${service.slug}`}
                    class="inline-flex items-center gap-1.5 min-h-[44px] font-bold text-purple-700 hover:text-purple-900 underline-offset-4 hover:underline rounded-sm focus-visible:outline-3 focus-visible:outline-purple-700 focus-visible:outline-offset-2"
                  >
                    <span>Read more<span class="sr-only"> about {service.title}</span></span>
                    <span aria-hidden="true">→</span>
                  </a>
                </div>
              </Card>
            </li>
          ))
        }
      </ul>

      <div class="mt-12 text-center">
        <Button href="/services" variant="outline" size="md">See all {SERVICES.length} services</Button>
      </div>
    </Container>
  </Section>

  <Section variant="tint">
    <Container>
      <div class="text-center max-w-3xl mx-auto mb-12">
        <Badge variant="purple" class="mb-3">What we stand for</Badge>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-green-900 mb-4">Guided by Our Values</h2>
        <p class="text-lg text-ink">
          {SITE.directors.join(" and ")} started Empowerwell Support so every participant is treated with dignity and respect,
          and has real choice.
        </p>
      </div>

      <ul class="grid grid-cols-1 md:grid-cols-3 gap-6" role="list">
        {
          keyValues.map((val) => (
            <li>
              <Card variant="white" padding="md" class="h-full border border-green-100">
                <h3 class="text-xl font-bold text-purple-700">{val.name}</h3>
                <p class="text-sm font-bold text-green-900 uppercase tracking-wider mt-1 mb-2">{val.tagline}</p>
                <p class="text-base text-ink leading-relaxed">{val.description}</p>
              </Card>
            </li>
          ))
        }
      </ul>

      <div class="mt-10 text-center">
        <a
          href="/about"
          class="inline-flex items-center gap-1.5 min-h-[44px] font-bold text-purple-700 underline underline-offset-4 rounded-sm focus-visible:outline-3 focus-visible:outline-purple-700 focus-visible:outline-offset-2"
        >
          Read all our values and meet our directors <span aria-hidden="true">→</span>
        </a>
      </div>
    </Container>
  </Section>

  <Section variant="surface" aria-labelledby="community-heading">
    <Container>
      <div class="text-center max-w-3xl mx-auto mb-12">
        <Badge variant="tint" class="mb-3">Community access</Badge>
        <h2 id="community-heading" class="text-3xl sm:text-4xl font-extrabold text-green-900 mb-4">Life in the Community</h2>
        <p class="text-lg text-ink">
          We support people to get out, try new things and enjoy their local area: cafés, outings, swimming and more.
        </p>
      </div>

      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" role="list">
        {
          COMMUNITY_GALLERY.map((photo) => (
            <li>
              <figure class="h-full rounded-[12px] overflow-hidden bg-white border border-border-card shadow-soft">
                <Picture
                  src={photo.src}
                  alt={photo.alt}
                  formats={["avif", "webp"]}
                  widths={[400, 600, 900]}
                  sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw"
                  loading="lazy"
                  class="w-full h-auto aspect-[3/4] object-cover"
                />
                <figcaption class="px-4 py-3 text-base font-bold text-green-900">{photo.caption}</figcaption>
              </figure>
            </li>
          ))
        }
      </ul>

      <div class="mt-10 text-center">
        <a
          href="/services#community-participation"
          class="inline-flex items-center gap-1.5 min-h-[44px] font-bold text-purple-700 underline underline-offset-4 rounded-sm focus-visible:outline-3 focus-visible:outline-purple-700 focus-visible:outline-offset-2"
        >
          About our community participation support <span aria-hidden="true">→</span>
        </a>
      </div>
    </Container>
  </Section>

  <Section variant="tint">
    <Container>
      <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
        <Badge variant="tint" class="mb-3">3 simple steps</Badge>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-green-900 mb-4">How to Get Started</h2>
        <p class="text-lg text-ink">Here is what happens when you contact us.</p>
      </div>

      <ol class="grid grid-cols-1 md:grid-cols-3 gap-8" role="list">
        {
          steps.map((step, i) => (
            <li class="p-6 sm:p-8 rounded-[12px] bg-white border border-border-card shadow-soft text-center space-y-4">
              <div
                class="w-14 h-14 rounded-full bg-green-900 text-white font-heading font-extrabold text-2xl mx-auto flex items-center justify-center"
                aria-hidden="true"
              >
                {i + 1}
              </div>
              <h3 class="text-xl font-bold text-green-900"><span class="sr-only">Step {i + 1}: </span>{step.title}</h3>
              <p class="text-base text-ink leading-relaxed">{step.body}</p>
            </li>
          ))
        }
      </ol>

      <div class="mt-12 text-center">
        <Button href="/contact#enquiry-form" variant="primary" size="lg">Make a Referral</Button>
      </div>
    </Container>
  </Section>

  <Section variant="green">
    <Container>
      <div class="max-w-4xl mx-auto text-center space-y-6">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white">Ready to talk about your supports?</h2>
        <p class="text-lg sm:text-xl text-green-100 max-w-2xl mx-auto leading-relaxed">
          Whether you already have an NDIS plan or are still applying, we are happy to help.
        </p>
        <div class="pt-4 flex flex-wrap justify-center gap-4">
          <Button href="/contact#enquiry-form" variant="lime" size="lg">Make a Referral</Button>
          <Button href={SITE.phoneHref} variant="outline" size="lg" class="border-white text-white hover:bg-white/10 focus-visible:outline-lime-400">
            Call {SITE.phone}
          </Button>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
