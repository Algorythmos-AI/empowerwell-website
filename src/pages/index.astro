---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import Card from "../components/ui/Card.astro";
import Badge from "../components/ui/Badge.astro";
import Button from "../components/ui/Button.astro";
import { SITE } from "../content/site";
import { SERVICES } from "../content/services";
import { VALUES } from "../content/values";

const highlightServices = SERVICES.filter((s) => s.isHighlight).slice(0, 6);
---

<BaseLayout
  title={`${SITE.brandName} · Empowering You to Thrive in Western Sydney`}
  description="Empowerwell Support Pty Ltd is a registered NDIS provider in Western Sydney offering person-centred disability support, SIL, personal care, and community participation."
>
  {/* 1. Hero Section */}
  <Section variant="surface" class="pt-8 sm:pt-12 md:pt-16 pb-16">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        {/* Left Column: Heading & Actions */}
        <div class="lg:col-span-7 space-y-6">
          <Badge variant="tint" class="text-sm">
            Western Sydney Registered NDIS Provider · Reg: {SITE.ndisRegistration}
          </Badge>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-green-900 leading-[1.15]">
            Empowering You to <span class="text-purple-700">Thrive</span> with Choice & Dignity
          </h1>

          <p class="text-lg sm:text-xl text-ink leading-relaxed max-w-2xl">
            Welcome to Empowerwell Support. We provide compassionate, person-centred disability support and 24/7 Supported Independent Living (SIL) across Western Sydney and regional NSW.
          </p>

          {/* Primary CTAs */}
          <div class="pt-2 flex flex-wrap items-center gap-4">
            <Button href="/contact" variant="primary" size="lg">
              Make a Referral
            </Button>
            <Button href={SITE.phoneHref} variant="outline" size="lg">
              <svg class="w-5 h-5 mr-2 text-purple-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <span>Call {SITE.phone}</span>
            </Button>
          </div>

          {/* Quick reassurance points */}
          <div class="pt-4 flex flex-wrap items-center gap-6 text-sm text-muted">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span>Free Meet & Greet</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span>NDIA, Plan & Self-Managed</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span>24/7 Available Supports</span>
            </div>
          </div>
        </div>

        {/* Right Column: Hero Visual Asset */}
        <div class="lg:col-span-5">
          <div class="relative rounded-[16px] overflow-hidden border-2 border-green-100 shadow-soft-lg bg-surface-tint">
            <img
              src="/images/carer-and-participant-park.svg"
              alt="Illustration of Empowerwell support worker and participant enjoying a friendly community walk in Western Sydney park"
              class="w-full h-auto aspect-[4/3] object-cover"
              width="800"
              height="500"
              loading="eager"
            />
            <div class="p-4 bg-white/95 border-t border-green-100">
              <p class="text-xs text-muted font-bold uppercase tracking-wider">
                Support in Everyday Community Settings
              </p>
              <p class="text-sm font-bold text-green-900">
                Tailored one-on-one care matching your unique lifestyle and goals.
              </p>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  {/* 2. Trust Bar */}
  <section class="bg-purple-700 text-white py-5" aria-label="Key Provider Credentials">
    <Container>
      <div class="flex flex-wrap items-center justify-around gap-6 text-center text-sm sm:text-base font-bold">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-lime-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span>Registered NDIS Provider</span>
        </div>
        <span class="hidden sm:inline text-purple-300" aria-hidden="true">·</span>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-lime-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>24/7 Reliable Supports</span>
        </div>
        <span class="hidden sm:inline text-purple-300" aria-hidden="true">·</span>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-lime-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          </svg>
          <span>Greater Sydney & Regional NSW</span>
        </div>
      </div>
    </Container>
  </section>

  {/* 3. Service Highlights */}
  <Section variant="surface" id="services">
    <Container>
      <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
        <Badge variant="tint" class="mb-3">Our Core Supports</Badge>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-green-900 mb-4">
          Services Designed Around Your Goals
        </h2>
        <p class="text-lg text-ink">
          From round-the-clock independent living to everyday personal care and community outings, we deliver holistic care tailored to you.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          highlightServices.map((service) => (
            <Card variant="white" padding="md" class="flex flex-col justify-between hover:shadow-soft-lg transition-all">
              <div class="space-y-4">
                <div class="w-12 h-12 rounded-full bg-surface-tint border border-green-200 flex items-center justify-center text-green-900">
                  <svg class="w-6 h-6 text-green-800" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                  </svg>
                </div>
                <h3 class="text-xl font-bold text-ink">
                  {service.title}
                </h3>
                <p class="text-base text-muted leading-relaxed">
                  {service.shortDescription}
                </p>
              </div>

              <div class="pt-6 mt-6 border-t border-green-50 flex items-center justify-between">
                <a
                  href={`/contact?service=${encodeURIComponent(service.slug)}`}
                  class="font-bold text-purple-700 hover:text-purple-900 inline-flex items-center gap-1.5 focus-visible:outline-2 focus-visible:outline-purple-700 rounded p-1 text-sm sm:text-base"
                >
                  <span>Enquire about this service</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </Card>
          ))
        }
      </div>

      <div class="mt-12 text-center">
        <Button href="/services" variant="secondary" size="md">
          Explore All 11 Services
        </Button>
      </div>
    </Container>
  </Section>

  {/* 4. Why Empowerwell: Values Grid */}
  <Section variant="tint">
    <Container>
      <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
        <Badge variant="purple" class="mb-3">Why Choose Empowerwell</Badge>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-green-900 mb-4">
          Guided by Integrity, Dignity & Respect
        </h2>
        <p class="text-lg text-ink">
          Our founders, Aiwen Kuel & Lual Chol, established Empowerwell Support with a simple promise: every participant is treated like family, with full choice and unwavering respect.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          VALUES.map((val) => (
            <Card variant="white" padding="md" class="border border-green-100">
              <div class="space-y-3">
                <div class="w-10 h-10 rounded-full bg-purple-100 text-purple-700 flex items-center justify-center font-bold">
                  ✓
                </div>
                <h3 class="text-xl font-bold text-purple-700">
                  {val.name}
                </h3>
                <p class="text-xs font-bold text-green-900 uppercase tracking-wider">
                  {val.tagline}
                </p>
                <p class="text-base text-ink leading-relaxed">
                  {val.description}
                </p>
              </div>
            </Card>
          ))
        }
      </div>
    </Container>
  </Section>

  {/* 5. 3-Step "How to get started" */}
  <Section variant="surface">
    <Container>
      <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
        <Badge variant="tint" class="mb-3">Simple 3-Step Process</Badge>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-green-900 mb-4">
          How to Get Started with Us
        </h2>
        <p class="text-lg text-ink">
          We take the stress out of starting new supports. Here is what happens when you reach out:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {/* Step 1 */}
        <div class="relative p-6 sm:p-8 rounded-[12px] bg-white border border-border-card shadow-soft text-center space-y-4">
          <div class="w-14 h-14 rounded-full bg-green-900 text-white font-heading font-extrabold text-2xl mx-auto flex items-center justify-center">
            1
          </div>
          <h3 class="text-xl font-bold text-green-900">
            Friendly Chat
          </h3>
          <p class="text-base text-ink leading-relaxed">
            Fill out our simple referral form or call us on <strong class="text-purple-700">{SITE.phone}</strong>. We will speak with you within 24 business hours to understand your goals and current NDIS plan.
          </p>
        </div>

        {/* Step 2 */}
        <div class="relative p-6 sm:p-8 rounded-[12px] bg-white border border-border-card shadow-soft text-center space-y-4">
          <div class="w-14 h-14 rounded-full bg-purple-700 text-white font-heading font-extrabold text-2xl mx-auto flex items-center justify-center">
            2
          </div>
          <h3 class="text-xl font-bold text-purple-700">
            Free Meet & Greet
          </h3>
          <p class="text-base text-ink leading-relaxed">
            We meet at your home, a local cafe, or our Dharruk office. You will meet your support coordinator or worker in person with zero commitment or pressure.
          </p>
        </div>

        {/* Step 3 */}
        <div class="relative p-6 sm:p-8 rounded-[12px] bg-white border border-border-card shadow-soft text-center space-y-4">
          <div class="w-14 h-14 rounded-full bg-lime-400 text-ink font-heading font-extrabold text-2xl mx-auto flex items-center justify-center">
            3
          </div>
          <h3 class="text-xl font-bold text-green-900">
            Commence Supports
          </h3>
          <p class="text-base text-ink leading-relaxed">
            Together we agree on a transparent service agreement and support schedule. Your dedicated care begins smoothly with ongoing check-ins and open feedback.
          </p>
        </div>
      </div>

      <div class="mt-12 text-center">
        <Button href="/contact" variant="primary" size="lg">
          Start Step 1: Make a Referral
        </Button>
      </div>
    </Container>
  </Section>

  {/* 6. Final Call to Action Banner */}
  <Section variant="green">
    <Container>
      <div class="max-w-4xl mx-auto text-center space-y-6">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white">
          Ready to experience person-centred disability support?
        </h2>
        <p class="text-lg sm:text-xl text-green-100 max-w-2xl mx-auto leading-relaxed">
          Whether you have an established NDIS plan or are exploring your options, our friendly team is here to help you thrive.
        </p>
        <div class="pt-4 flex flex-wrap justify-center gap-4">
          <Button href="/contact" variant="lime" size="lg">
            Make a Referral Online
          </Button>
          <Button href={SITE.phoneHref} variant="outline" size="lg" class="border-white text-white hover:bg-white/10">
            Call Us at {SITE.phone}
          </Button>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
