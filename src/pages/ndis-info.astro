---
import { PAGES } from "../content/pages";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import Badge from "../components/ui/Badge.astro";
import Button from "../components/ui/Button.astro";
import FaqList from "../components/ui/FaqList.astro";
import { SITE } from "../content/site";
import { FAQS } from "../content/faqs";
---

<BaseLayout meta={PAGES.ndisInfo}>
  {/* Hero */}
  <Section variant="surface" class="pt-8 sm:pt-12 pb-12">
    <Container>
      <div class="max-w-3xl">
        <Badge variant="tint" class="mb-4">Plain-English answers</Badge>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-green-900 mb-6 leading-tight">
          Understanding Your NDIS Plan & Options
        </h1>
        <p class="text-xl text-ink leading-relaxed">
          The NDIS can feel complicated. Here are simple answers to common questions about plans, costs and choosing a provider.
        </p>
      </div>
    </Container>
  </Section>

  {/* FAQ Accordion Section */}
  <Section variant="tint">
    <Container>
      <div class="max-w-4xl mx-auto space-y-8">
        <div>
          <h2 class="text-3xl font-extrabold text-green-900 mb-3">
            Frequently Asked Questions
          </h2>
          <p class="text-base text-ink">Select a question to see the answer.</p>
        </div>

        <FaqList items={FAQS} />

        {/* Direct Help Callout */}
        <div class="mt-12 p-8 rounded-[12px] bg-white border border-green-200 shadow-soft text-center space-y-4">
          <h2 class="text-2xl font-bold text-green-900">
            Have a question not listed here?
          </h2>
          <p class="text-base text-ink max-w-xl mx-auto">
            Call or send us a question. We are happy to explain your options in plain language.
          </p>
          <div class="pt-2 flex flex-wrap justify-center gap-4">
            <Button href={SITE.phoneHref} variant="primary" size="md">
              Call Us at {SITE.phone}
            </Button>
            <Button href="/contact#enquiry-form" variant="outline" size="md">
              Send an Online Question
            </Button>
          </div>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
