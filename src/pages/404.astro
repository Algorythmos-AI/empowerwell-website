---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import Button from "../components/ui/Button.astro";
import { SITE } from "../content/site";
---

<BaseLayout
  title={`Page Not Found (404) · ${SITE.brandName}`}
  description="The page you were looking for could not be found. Return to Empowerwell Support's homepage."
>
  <Section variant="surface" class="py-20 sm:py-28 text-center">
    <Container>
      <div class="max-w-2xl mx-auto space-y-6">
        <span class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-purple-100 text-purple-700 font-heading font-extrabold text-3xl">
          404
        </span>

        <h1 class="text-3xl sm:text-4xl font-extrabold text-green-900">
          Page Not Found
        </h1>

        <p class="text-lg text-ink leading-relaxed">
          We are sorry, but the page you are looking for does not exist or may have been moved. Let's get you back on track:
        </p>

        <div class="pt-4 flex flex-wrap justify-center gap-4">
          <Button href="/" variant="primary" size="lg">
            Return to Homepage
          </Button>
          <Button href="/services" variant="outline" size="lg">
            View Our Services
          </Button>
          <Button href="/contact" variant="ghost" size="lg">
            Contact Us
          </Button>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
