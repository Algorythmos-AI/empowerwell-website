---
import { Image } from "astro:assets";
import emblem from "../../assets/brand/emblem.png";
import { FOOTER, SITE } from "../../content/site";

// On the dark footer, purple focus rings would fail 3:1 contrast, so lime is used instead
// (the one documented exception to the purple focus-ring rule in CLAUDE.md).
const linkClass =
  "inline-flex items-center min-h-[44px] text-green-100 hover:text-white underline-offset-4 hover:underline rounded-sm transition-colors focus-visible:outline-3 focus-visible:outline-lime-400 focus-visible:outline-offset-2";
const socials = Object.entries(SITE.socials).filter((entry): entry is [string, string] => Boolean(entry[1]));
---

<footer class="bg-green-950 text-white pt-16 pb-10 border-t-4 border-green-500" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Site information</h2>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12 pb-12 border-b border-green-800">
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <span class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-white shrink-0">
            <Image src={emblem} alt="" width={40} height={Math.round((40 * emblem.height) / emblem.width)} densities={[1, 2]} class="w-10 h-auto" />
          </span>
          <span class="flex flex-col leading-tight">
            <span class="font-heading font-extrabold text-lg text-white">{SITE.brandName}</span>
            <span class="text-xs font-bold uppercase tracking-[0.12em] text-green-200">{SITE.tagline}</span>
          </span>
        </div>
        <p class="text-green-100 text-sm leading-relaxed">{SITE.footerBlurb}</p>

        <div class="p-3.5 rounded-[12px] bg-green-900/60 border border-green-700/60 text-xs text-green-100 space-y-1">
          <p class="font-extrabold text-white flex items-center gap-1.5 text-sm">
            <span class="w-2 h-2 rounded-full bg-lime-400" aria-hidden="true"></span>
            Registered NDIS Provider
          </p>
          <p>Registration ID: <span class="font-mono text-white font-bold">{SITE.ndisRegistration}</span></p>
          <p>ABN: <span class="font-mono text-white font-bold">{SITE.abn}</span></p>
        </div>
      </div>

      <nav aria-labelledby="footer-explore">
        <h3 id="footer-explore" class="text-white text-base font-extrabold tracking-wider uppercase mb-3 font-heading">
          {FOOTER.exploreHeading}
        </h3>
        <ul class="text-sm" role="list">
          {FOOTER.explore.map((link) => <li><a href={link.href} class={linkClass}>{link.label}</a></li>)}
        </ul>
      </nav>

      <div>
        <h3 class="text-white text-base font-extrabold tracking-wider uppercase mb-3 font-heading">
          {FOOTER.contactHeading}
        </h3>
        <ul class="space-y-2 text-sm text-green-100" role="list">
          <li class="flex items-start gap-2.5">
            <svg class="w-5 h-5 text-lime-400 shrink-0 mt-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            <div>
              <a href={SITE.phoneHref} class={`${linkClass} font-bold text-white`}>{SITE.phone}</a>
              <p class="text-xs text-green-200">{SITE.phoneLabel}</p>
            </div>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-5 h-5 text-lime-400 shrink-0 mt-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <a href={SITE.emailHref} class={`${linkClass} text-white break-all`}>{SITE.email}</a>
          </li>
          <li class="flex items-start gap-2.5 py-2">
            <svg class="w-5 h-5 text-lime-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <span>{SITE.streetAddress}, {SITE.suburb} {SITE.state} {SITE.postcode}<br />Servicing {SITE.serviceAreas}</span>
          </li>
          <li class="pt-1 text-xs text-green-200 space-y-1">
            <p><span class="font-bold text-white">Office hours:</span> {SITE.officeHours}</p>
            <p><span class="font-bold text-white">Supports:</span> {SITE.supportHours}</p>
          </li>
        </ul>
        {
          socials.length > 0 && (
            <ul class="mt-4 flex gap-4 text-sm" role="list">
              {socials.map(([name, url]) => (
                <li>
                  <a href={url} class={`${linkClass} capitalize`} rel="noopener">
                    {name}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <div>
        <h3 class="text-white text-base font-extrabold tracking-wider uppercase mb-3 font-heading">
          {FOOTER.safetyHeading}
        </h3>
        <p class="text-green-100 text-sm leading-relaxed mb-4">{FOOTER.safetyBlurb}</p>
        <div class="space-y-3">
          {
            FOOTER.safetyLinks.map((link, i) => (
              <a
                href={link.href}
                class:list={[
                  "inline-flex items-center justify-center w-full min-h-[44px] py-2.5 px-4 rounded-full text-sm font-bold text-center transition-colors focus-visible:outline-3 focus-visible:outline-lime-400 focus-visible:outline-offset-2",
                  i === 0
                    ? "bg-green-900 border border-green-700 text-white hover:bg-green-800"
                    : "border border-green-700 text-green-100 hover:text-white hover:border-green-500",
                ]}
              >
                {link.label}
              </a>
            ))
          }
          <a
            href={SITE.ndisProviderRegisterUrl}
            rel="noopener"
            class="inline-flex items-center justify-center w-full min-h-[44px] py-2.5 px-4 rounded-full text-sm font-bold text-center border border-green-700 text-green-100 hover:text-white hover:border-green-500 transition-colors focus-visible:outline-3 focus-visible:outline-lime-400 focus-visible:outline-offset-2"
          >
            {FOOTER.registerLabel}
          </a>
        </div>
      </div>
    </div>

    <div class="py-8 border-b border-green-800/80 text-sm text-green-100 leading-relaxed">
      <p class="font-bold text-lime-400 mb-1">Acknowledgement of Country</p>
      <p>{SITE.acknowledgementOfCountry}</p>
    </div>

    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-2 sm:gap-4 text-xs text-green-200">
      <p class="text-center sm:text-left">© {new Date().getFullYear()} {SITE.legalName}. All rights reserved.</p>
      <ul class="flex flex-wrap items-center justify-center gap-x-6" role="list">
        {FOOTER.legal.map((link) => <li><a href={link.href} class={linkClass.replace("text-green-100", "text-green-200")}>{link.label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>
