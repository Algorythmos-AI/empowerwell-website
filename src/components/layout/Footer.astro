---
import { SITE } from "../../content/site";
---

<footer class="bg-green-950 text-white pt-16 pb-12 border-t-4 border-green-500" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Footer Information and Navigation</h2>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12 pb-12 border-b border-green-800">
      {/* Col 1: Brand & Registration */}
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <img
            src="/logo.svg"
            alt="Empowerwell Support logo"
            class="h-10 w-auto brightness-0 invert"
            width="160"
            height="40"
          />
        </div>
        <p class="text-green-100 text-sm leading-relaxed">
          {SITE.tagline}. Delivering compassionate, person-centred disability support and SIL services across Western Sydney and regional NSW.
        </p>

        {/* NDIS Registration Block (Text-only per NDIA guidelines) */}
        <div class="p-3.5 rounded-[12px] bg-green-900/60 border border-green-700/60 text-xs text-green-100 space-y-1">
          <p class="font-extrabold text-white flex items-center gap-1.5 text-sm">
            <span class="w-2 h-2 rounded-full bg-lime-400" aria-hidden="true"></span>
            Registered NDIS Provider
          </p>
          <p>Registration ID: <span class="font-mono text-white font-bold">{SITE.ndisRegistration}</span></p>
          <p>ABN: <span class="font-mono text-white font-bold">{SITE.abn}</span></p>
        </div>
      </div>

      {/* Col 2: Quick Links */}
      <div>
        <h3 class="text-white text-base font-extrabold tracking-wider uppercase mb-4 font-heading">
          Explore
        </h3>
        <ul class="space-y-2.5 text-sm" role="list">
          <li>
            <a href="/" class="text-green-200 hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-lime-400 rounded">
              Home
            </a>
          </li>
          <li>
            <a href="/services" class="text-green-200 hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-lime-400 rounded">
              Our 11 Services
            </a>
          </li>
          <li>
            <a href="/who-we-support" class="text-green-200 hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-lime-400 rounded">
              Who We Support
            </a>
          </li>
          <li>
            <a href="/ndis-info" class="text-green-200 hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-lime-400 rounded">
              NDIS Info & FAQs
            </a>
          </li>
          <li>
            <a href="/about" class="text-green-200 hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-lime-400 rounded">
              About Empowerwell
            </a>
          </li>
          <li>
            <a href="/contact" class="text-green-200 hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-lime-400 rounded">
              Make a Referral / Contact
            </a>
          </li>
        </ul>
      </div>

      {/* Col 3: Contact & Hours */}
      <div>
        <h3 class="text-white text-base font-extrabold tracking-wider uppercase mb-4 font-heading">
          Get in Touch
        </h3>
        <ul class="space-y-3 text-sm text-green-100" role="list">
          <li class="flex items-start gap-2.5">
            <svg class="w-5 h-5 text-lime-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <div>
              <a href={SITE.phoneHref} class="font-bold text-white hover:text-lime-300 transition-colors focus-visible:outline-2 focus-visible:outline-lime-400 rounded">
                {SITE.phone}
              </a>
              <p class="text-xs text-green-300">Western Sydney Local Office</p>
            </div>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-5 h-5 text-lime-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href={SITE.emailHref} class="text-white hover:text-lime-300 transition-colors focus-visible:outline-2 focus-visible:outline-lime-400 rounded">
              {SITE.email}
            </a>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-5 h-5 text-lime-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{SITE.suburb} {SITE.state} {SITE.postcode}, Australia</span>
          </li>
          <li class="pt-1 text-xs text-green-200">
            <p><span class="font-bold text-white">Office Hours:</span> {SITE.officeHours}</p>
            <p><span class="font-bold text-white">Active Supports:</span> {SITE.supportHours}</p>
          </li>
        </ul>
      </div>

      {/* Col 4: Quality & Feedback */}
      <div>
        <h3 class="text-white text-base font-extrabold tracking-wider uppercase mb-4 font-heading">
          Feedback & Safety
        </h3>
        <p class="text-green-100 text-sm leading-relaxed mb-4">
          Your voice and safety matter. We welcome all compliments, suggestions, and complaints to continually improve our supports.
        </p>
        <div class="space-y-2">
          <a
            href="/feedback"
            class="inline-flex items-center justify-center w-full py-2.5 px-4 rounded-full bg-green-900 border border-green-700 text-white text-sm font-bold hover:bg-green-800 transition-colors text-center focus-visible:outline-2 focus-visible:outline-lime-400"
          >
            Feedback & Complaints Procedure
          </a>
          <a
            href="/privacy"
            class="inline-flex items-center justify-center w-full py-2.5 px-4 rounded-full bg-transparent border border-green-800 text-green-200 text-sm font-medium hover:text-white hover:border-green-700 transition-colors text-center focus-visible:outline-2 focus-visible:outline-lime-400"
          >
            Privacy Policy
          </a>
        </div>
      </div>
    </div>

    {/* Indigenous Acknowledgement of Country */}
    <div class="py-8 border-b border-green-800/80 text-sm text-green-200 leading-relaxed">
      <p class="font-bold text-lime-400 mb-1">Acknowledgement of Country</p>
      <p>{SITE.acknowledgementOfCountry}</p>
    </div>

    {/* Copyright & Compliance Bar */}
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-green-300">
      <p>
        © {new Date().getFullYear()} {SITE.legalName}. All rights reserved.
      </p>
      <div class="flex items-center gap-6">
        <a href="/privacy" class="hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-lime-400 rounded">
          Privacy Policy
        </a>
        <a href="/feedback" class="hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-lime-400 rounded">
          NDIS Safeguards
        </a>
        <a href="/sitemap-index.xml" class="hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-lime-400 rounded">
          Sitemap
        </a>
      </div>
    </div>
  </div>
</footer>
