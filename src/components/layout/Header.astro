---
import { SITE } from "../../content/site";
import MobileMenu from "../islands/MobileMenu";

interface Props {
  currentPath?: string;
}

const { currentPath = "" } = Astro.props;

const navLinks = [
  { href: "/services", label: "Services" },
  { href: "/who-we-support", label: "Who We Support" },
  { href: "/ndis-info", label: "NDIS Guide & FAQs" },
  { href: "/about", label: "About Us" },
  { href: "/contact", label: "Contact & Referral" },
];
---

<header class="sticky top-0 z-40 bg-surface/95 backdrop-blur-md border-b border-border-card transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20 gap-4 lg:gap-8">
      {/* Zone 1: Single Brand Lockup with Logo */}
      <a
        href="/"
        class="flex items-center gap-3 group focus-visible:outline-3 focus-visible:outline-purple-700 rounded-lg p-1 shrink-0 no-underline"
        aria-label="Empowerwell Support Pty Ltd — Go to Home"
      >
        <img
          src="/logo.svg"
          alt="Empowerwell Support logo"
          class="h-10 sm:h-12 w-auto object-contain"
          width="180"
          height="48"
        />
      </a>

      {/* Zone 2: Navigation Links */}
      <nav class="hidden md:flex items-center gap-6 lg:gap-8 text-base font-bold text-ink" aria-label="Main Navigation">
        {
          navLinks.map((link) => {
            const isActive = currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href));
            return (
              <a
                href={link.href}
                class={`whitespace-nowrap transition-colors py-2 border-b-2 hover:text-purple-700 focus-visible:outline-3 focus-visible:outline-purple-700 rounded-sm ${
                  isActive
                    ? "text-purple-700 border-purple-700 font-extrabold"
                    : "border-transparent text-ink hover:border-purple-300"
                }`}
                aria-current={isActive ? "page" : undefined}
              >
                {link.label}
              </a>
            );
          })
        }
      </nav>

      {/* Zone 3: Direct Actions & Mobile Toggle */}
      <div class="flex items-center gap-3 shrink-0">
        {/* Prominent Tap-to-Call Button */}
        <a
          href={SITE.phoneHref}
          class="hidden sm:inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full bg-surface-tint border-2 border-purple-700 text-purple-700 font-heading font-extrabold text-sm sm:text-base hover:bg-purple-50 active:bg-purple-100 transition-colors focus-visible:outline-3 focus-visible:outline-green-900 min-h-[44px] shrink-0"
          aria-label={`Call Empowerwell Support on ${SITE.phone}`}
        >
          <svg class="w-4 h-4 text-purple-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>{SITE.phone}</span>
        </a>

        {/* Primary CTA (Make a Referral) */}
        <a
          href="/contact"
          class="hidden lg:inline-flex items-center justify-center px-5 py-2.5 rounded-full bg-green-900 text-white font-heading font-extrabold text-sm sm:text-base hover:bg-green-800 active:bg-green-950 transition-colors shadow-soft focus-visible:outline-3 focus-visible:outline-purple-700 min-h-[44px] shrink-0"
        >
          Make a Referral
        </a>

        {/* Mobile Navigation Island */}
        <MobileMenu
          client:load
          navLinks={navLinks}
          phone={SITE.phone}
          phoneHref={SITE.phoneHref}
        />
      </div>
    </div>
  </div>
</header>
