---
import { Image } from "astro:assets";
import emblem from "../../assets/brand/emblem.png";
import { CTA, NAV, SITE } from "../../content/site";
import MobileMenu from "./MobileMenu.astro";

interface Props {
  currentPath?: string;
}

const { currentPath = "" } = Astro.props;
const isActive = (href: string) => currentPath === href || (href !== "/" && currentPath.startsWith(`${href}/`));
const registrationLabel = `Registered NDIS Provider · ${SITE.ndisRegistration}`;
---

<header class="sticky top-0 z-40 bg-surface/95 backdrop-blur-md border-b border-border-card">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20 gap-2 min-[360px]:gap-3 xl:gap-5 2xl:gap-6">
      <a
        href="/"
        class="flex items-center gap-2.5 sm:gap-3 rounded-lg p-1 -ml-1 min-w-0 no-underline focus-visible:outline-3 focus-visible:outline-purple-700 focus-visible:outline-offset-2"
      >
        <Image
          src={emblem}
          alt=""
          width={56}
          height={Math.round((56 * emblem.height) / emblem.width)}
          densities={[1, 2]}
          loading="eager"
          class="h-10 min-[400px]:h-11 sm:h-12 w-auto shrink-0"
        />
        <span class="flex flex-col leading-tight min-w-0">
          <span class="font-heading font-extrabold text-green-900 text-[0.85rem] min-[360px]:text-base min-[400px]:text-lg sm:text-xl tracking-tight truncate">
            {SITE.brandName}
          </span>
          <span class="hidden min-[360px]:block text-[0.6rem] min-[400px]:text-[0.7rem] sm:text-xs font-bold uppercase tracking-[0.12em] xl:tracking-[0.1em] 2xl:tracking-[0.12em] text-muted truncate">
            {SITE.tagline}
          </span>
        </span>
      </a>

      <nav class="hidden xl:flex items-center gap-5 2xl:gap-8 text-base font-bold text-ink" aria-label="Main">
        {
          NAV.map((link) => (
            <a
              href={link.href}
              class:list={[
                "whitespace-nowrap py-2 border-b-2 rounded-sm transition-colors hover:text-purple-700 focus-visible:outline-3 focus-visible:outline-purple-700 focus-visible:outline-offset-2",
                isActive(link.href)
                  ? "text-purple-700 border-purple-700 font-extrabold"
                  : "border-transparent hover:border-purple-300",
              ]}
              aria-current={isActive(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-2 sm:gap-3 shrink-0">
        <a
          href={SITE.phoneHref}
          class="hidden sm:inline-flex items-center justify-center gap-2 px-4 xl:px-3 py-2.5 min-w-[44px] rounded-full bg-surface-tint border-2 border-purple-700 text-purple-700 font-heading font-extrabold text-base whitespace-nowrap hover:bg-purple-50 active:bg-purple-100 transition-colors min-h-[44px] focus-visible:outline-3 focus-visible:outline-purple-700 focus-visible:outline-offset-2"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          <span class="sr-only">Call {SITE.brandName} on {SITE.phone}</span>
          <span class="xl:hidden" aria-hidden="true">{SITE.phone}</span>
        </a>

        <a
          href={CTA.referral.href}
          class="hidden xl:inline-flex items-center justify-center px-4 2xl:px-5 py-2.5 rounded-full bg-green-900 text-white font-heading font-extrabold text-base whitespace-nowrap hover:bg-green-800 active:bg-green-950 transition-colors shadow-soft min-h-[44px] focus-visible:outline-3 focus-visible:outline-purple-700 focus-visible:outline-offset-2"
        >
          {CTA.referral.label}
        </a>

        <MobileMenu
          navLinks={NAV}
          currentPath={currentPath}
          phone={SITE.phone}
          phoneHref={SITE.phoneHref}
          phone2={SITE.phone2}
          phone2Href={SITE.phone2Href}
          referral={CTA.referral}
          brandName={SITE.brandName}
          registrationLabel={registrationLabel}
        />
      </div>
    </div>
  </div>

  <noscript>
    <nav class="xl:hidden border-t border-border-card bg-surface" aria-label="Main">
      <ul class="max-w-7xl mx-auto px-4 sm:px-6 py-2 flex flex-wrap gap-x-2 gap-y-1" role="list">
        {
          [...NAV, CTA.referral].map((link) => (
            <li>
              <a
                href={link.href}
                class="inline-flex items-center min-h-[44px] px-3 rounded-full font-bold text-ink hover:text-purple-700 hover:bg-surface-tint focus-visible:outline-3 focus-visible:outline-purple-700"
                aria-current={isActive(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </noscript>
</header>
