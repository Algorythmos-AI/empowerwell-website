---
interface Props {
  variant?: "primary" | "secondary" | "outline" | "ghost" | "lime";
  size?: "sm" | "md" | "lg";
  href?: string;
  type?: "button" | "submit" | "reset";
  class?: string;
  ariaLabel?: string;
  target?: string;
  rel?: string;
  download?: boolean | string;
}

const {
  variant = "primary",
  size = "md",
  href,
  type = "button",
  class: className = "",
  ariaLabel,
  target,
  rel,
  download,
} = Astro.props;

const baseStyles =
  "inline-flex items-center justify-center font-bold tracking-tight rounded-full transition-all duration-150 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed select-none no-underline text-center shrink-0 min-h-[44px]";

const sizeStyles = {
  sm: "px-4 py-2 text-sm min-w-[44px]",
  md: "px-6 py-3 text-base min-w-[44px]",
  lg: "px-8 py-4 text-lg min-w-[48px]",
};

const variantStyles = {
  primary:
    "bg-green-900 text-white hover:bg-green-800 active:bg-green-950 shadow-soft focus-visible:outline-purple-700",
  secondary:
    "bg-purple-700 text-white hover:bg-purple-800 active:bg-purple-900 shadow-soft focus-visible:outline-green-900",
  outline:
    "border-2 border-purple-700 text-purple-700 bg-transparent hover:bg-purple-50 active:bg-purple-100 focus-visible:outline-green-900",
  ghost:
    "text-purple-700 hover:bg-purple-50 active:bg-purple-100 focus-visible:outline-purple-700",
  lime:
    "bg-lime-400 text-ink hover:bg-lime-500 font-bold shadow-soft focus-visible:outline-purple-700",
};

const combinedClasses = `${baseStyles} ${sizeStyles[size]} ${variantStyles[variant]} ${className}`;
---

{
  href ? (
    <a
      href={href}
      class={combinedClasses}
      aria-label={ariaLabel}
      target={target}
      rel={target === "_blank" ? "noopener noreferrer" : rel}
      download={download}
    >
      <slot />
    </a>
  ) : (
    <button
      type={type}
      class={combinedClasses}
      aria-label={ariaLabel}
    >
      <slot />
    </button>
  )
}
