---
interface Option {
  value: string;
  label: string;
}

interface Props {
  id: string;
  name: string;
  label: string;
  options: Option[];
  placeholder?: string;
  required?: boolean;
  value?: string;
  error?: string;
  helperText?: string;
  class?: string;
}

const {
  id,
  name,
  label,
  options,
  placeholder = "Please select...",
  required = false,
  value,
  error,
  helperText,
  class: className = "",
} = Astro.props;
---

<div class={`flex flex-col gap-1.5 w-full ${className}`}>
  <label for={id} class="text-sm font-bold text-ink">
    {label}
    {required && <span class="text-purple-700 ml-0.5" aria-hidden="true">*</span>}
    {required && <span class="sr-only">(required)</span>}
  </label>

  <select
    id={id}
    name={name}
    required={required}
    aria-invalid={error ? "true" : "false"}
    aria-describedby={error ? `${id}-error` : helperText ? `${id}-helper` : undefined}
    class={`w-full min-h-[44px] px-4 py-2.5 rounded-[12px] bg-white text-ink text-base border transition-colors cursor-pointer
      ${error ? "border-purple-700 ring-1 ring-purple-700" : "border-border-card hover:border-green-600"}
      focus-visible:outline-3 focus-visible:outline-purple-700 focus-visible:outline-offset-2`}
  >
    {placeholder && <option value="" disabled selected={!value}>{placeholder}</option>}
    {options.map((opt) => (
      <option value={opt.value} selected={opt.value === value}>
        {opt.label}
      </option>
    ))}
  </select>

  {helperText && !error && (
    <p id={`${id}-helper`} class="text-xs text-muted">
      {helperText}
    </p>
  )}

  {error && (
    <p id={`${id}-error`} class="text-xs font-bold text-purple-700 flex items-center gap-1" role="alert">
      {error}
    </p>
  )}
</div>
