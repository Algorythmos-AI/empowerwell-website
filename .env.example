# Empowerwell Support Pty Ltd — environment configuration
# Copy to .env for local development. In production, set these in the Vercel project settings.
# Never commit real values.

# --- Enquiry form (api/enquiry.ts → Zoho Mail, Australian data centre) ---
# Server-only. Set in Vercel → Settings → Environment Variables (Production), then redeploy.
# ZOHO_SMTP_USER: the Zoho mailbox that signs in to SMTP.
# ZOHO_SMTP_PASSWORD: a Zoho app-specific password for that mailbox (Zoho Accounts → Security →
#   App Passwords). Never the normal login password.
ZOHO_SMTP_USER="lual.chol@empowerwellsupport.com.au"
ZOHO_SMTP_PASSWORD=""
# Optional: SMTP server. Organisation mailboxes must use smtppro (smtp.zoho.com.au fails with EAUTH).
ZOHO_SMTP_HOST="smtppro.zoho.com.au"
# Optional overrides (both default to info@empowerwellsupport.com.au):
# ENQUIRY_TO=""
# ENQUIRY_FROM=""

# Optional: point the form somewhere else (testing only). Defaults to /api/enquiry.
# PUBLIC_FORM_ENDPOINT=""
